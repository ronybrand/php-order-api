includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: max
    paths:
        - app
        - bootstrap
        - routes
        - tests
    tmpDir: .phpstan.cache
    ignoreErrors:
        # Laravel's TestResponse proxies Response methods through @mixin: PHPStan reads those proxied calls as
        # static ones. A false positive of the framework's test helpers, so it is limited to the tests.
        - identifier: staticMethod.dynamicCall
          path: tests/*
