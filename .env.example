APP_NAME=php-order-api
# production turns on the strict startup checks (explicit JWT audience/issuer, CORS origins, amqps:// broker, STARTTLS)
APP_ENV=local
APP_KEY=
APP_DEBUG=false

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_URL=postgres://orders:orders@127.0.0.1:5432/orders

# Rate limits and the notification queue need a shared cache and broker in production (one PHP process per request).
CACHE_STORE=file

JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
JWT_AUDIENCE=order-api
JWT_ISSUER=https://idp.example

# Comma-separated; must be set (and must not contain *) in production.
CORS_ORIGINS=
MAX_BODY_BYTES=1048576
RATE_LIMIT_PER_USER=120
RATE_LIMIT_WRITES=30
RATE_LIMIT_PER_IP=600

# Empty: the API works without publishing notifications. amqps:// is required in production.
BROKER_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
