{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "ronybrand/php-order-api",
    "type": "project",
    "description": "Order management API in PHP/Laravel (port of the fastapi-order-api spec).",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-pdo_pgsql": "*",
        "brick/math": "^0.14",
        "firebase/php-jwt": "^7.0",
        "laravel/framework": "^13.17",
        "php-amqplib/php-amqplib": "^3.7",
        "psr/clock": "^1.0",
        "symfony/clock": "^8.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php artisan test --testsuite=Unit",
        "test:integration": "@php artisan test --testsuite=Integration",
        "stan": "phpstan analyse --memory-limit=1G",
        "lint": "pint --test",
        "lint:fix": "pint",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
